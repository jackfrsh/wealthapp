# Copy to .env and fill in values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base URL — MUST be set in Cloudflare (or any non-Railway host) build env.
# Local dev: Vite proxy rewrites /api to 127.0.0.1:8000 so this can be omitted.
# Production (Cloudflare): set to the Railway backend URL so API calls reach it.
VITE_API_URL=https://app.getpaddock.com/api
